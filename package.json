    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/aos": "3.0.7",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
